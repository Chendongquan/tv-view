{
  "name": "tv-viewer",
  "productName": "TV Viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Android TV mirror with an on-screen remote, over ADB and scrcpy",
  "author": "Chendongquan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chendongquan/tv-view.git"
  },
  "homepage": "https://github.com/Chendongquan/tv-view#readme",
  "bugs": {
    "url": "https://github.com/Chendongquan/tv-view/issues"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check i18n.js",
    "make-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
